# Public assistant widget flag (browser-visible)
NEXT_PUBLIC_ASSISTANT_ENABLED=false

# AI provider: github | openai
AI_PROVIDER=github

# GitHub Models (required when AI_PROVIDER=github)
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4.1
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference

# OpenAI (required only when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=

# Assistant limits
ASSISTANT_MAX_INPUT_CHARS=1200
ASSISTANT_MAX_HISTORY_MESSAGES=8
ASSISTANT_MAX_TOTAL_CHARS=7000
ASSISTANT_MAX_OUTPUT_TOKENS=600
ASSISTANT_TIMEOUT_MS=25000
ASSISTANT_RATE_LIMIT_REQUESTS=8
ASSISTANT_RATE_LIMIT_WINDOW_SECONDS=300
ASSISTANT_RATE_LIMIT_SALT=

# Contact email delivery (optional — form fails safely if unset)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Journal CMS (optional — approved local content is used as fallback)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2026-07-01
